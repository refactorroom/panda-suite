{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Panda Security findings v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "audit",
    "findings",
    "scans",
    "coverage",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "panda-security.findings/v1"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "revision",
        "timestamp",
        "mode",
        "include",
        "exclude"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "mode": {
          "enum": [
            "quick",
            "deep",
            "skills",
            "verify"
          ]
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ruleId",
          "title",
          "category",
          "classification",
          "severity",
          "severityRationale",
          "confidence",
          "locations",
          "component",
          "evidence",
          "attackerPrerequisites",
          "attackScenario",
          "impact",
          "controlsConsidered",
          "remediation",
          "regression",
          "cwe",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SEC-[a-zA-Z0-9-]+$"
          },
          "ruleId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "Confirmed vulnerability",
              "Likely vulnerability",
              "Hardening",
              "Informational",
              "False positive"
            ]
          },
          "severity": {
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low",
              "Informational"
            ]
          },
          "severityRationale": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "Confirmed",
              "Likely",
              "Unknown"
            ]
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "lineStart",
                "lineEnd"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "lineStart": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "lineEnd": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                }
              }
            },
            "minItems": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "attackerPrerequisites": {
            "type": "string",
            "minLength": 1
          },
          "attackScenario": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "controlsConsidered": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          },
          "regression": {
            "type": "string",
            "minLength": 1
          },
          "cwe": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^CWE-[0-9]+$"
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "detail"
            ],
            "properties": {
              "status": {
                "enum": [
                  "source-traced",
                  "reproduced",
                  "advisory-matched",
                  "fixed",
                  "still-present",
                  "not-reproducible",
                  "unverified"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "uniqueItems": true
    },
    "scans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "version",
          "command",
          "status",
          "exitCode",
          "evidence",
          "limitations"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "command": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "status": {
            "enum": [
              "Completed",
              "Failed",
              "Not Run"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "status",
          "detail"
        ],
        "properties": {
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "Inspected",
              "Not applicable",
              "Unverified"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:panda-recon:intelligence:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "topic",
    "records",
    "sourceStatus",
    "projectExposure",
    "requests",
    "networkAvailability",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "panda-recon.intelligence/v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "topic": {
      "enum": [
        "latest",
        "update",
        "status",
        "owasp",
        "cve",
        "kev",
        "incidents"
      ]
    },
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "aliases",
          "recordType",
          "retrievedAt",
          "claims",
          "applicability",
          "conflictingStatus",
          "conflictingScores"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recordType": {
            "enum": [
              "vulnerability",
              "guidance",
              "advisory-lead"
            ]
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "claims": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "recordStatus",
                "source",
                "affected",
                "cvss"
              ],
              "properties": {
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "sourceId",
                    "url",
                    "retrievedAt",
                    "publishedAt",
                    "modifiedAt",
                    "sourceVersion",
                    "tier",
                    "verification"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "retrievedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "publishedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "modifiedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "sourceVersion": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "tier": {
                      "const": "primary"
                    },
                    "verification": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "evidence"
            ],
            "properties": {
              "status": {
                "const": "Not assessed"
              },
              "evidence": {
                "type": "array",
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "conflictingStatus": {
            "type": "boolean"
          },
          "conflictingScores": {
            "type": "boolean"
          }
        }
      }
    },
    "sourceStatus": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "enabled",
          "endpoint",
          "status",
          "ageSeconds",
          "lastSuccessfulSync",
          "lastAttemptError",
          "sourceVersion"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "enum": [
              "Fresh",
              "Stale",
              "Unavailable",
              "Disabled"
            ]
          },
          "ageSeconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "lastSuccessfulSync": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastAttemptError": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "refreshSucceeded": {
            "type": "boolean"
          },
          "previousSourceVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "versionChanged": {
            "type": "boolean"
          },
          "usedCachedSnapshot": {
            "type": "boolean"
          },
          "networkAvailability": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "projectExposure": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "component",
          "status",
          "advisoryId",
          "reachability",
          "localIncident",
          "sourceUrls"
        ],
        "properties": {
          "status": {
            "enum": [
              "Confirmed affected component",
              "Potentially affected component",
              "Not affected",
              "Version unknown",
              "Insufficient evidence"
            ]
          },
          "reachability": {
            "const": "Unverified"
          },
          "localIncident": {
            "const": "Not established"
          }
        }
      }
    },
    "requests": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "url",
          "method",
          "bodySent",
          "attempt"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "method": {
            "enum": [
              "GET",
              "POST"
            ]
          },
          "bodySent": {
            "type": "boolean"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      }
    },
    "networkAvailability": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
